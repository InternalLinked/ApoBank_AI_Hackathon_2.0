# Ausschliesslich serverseitig setzen, niemals mit NEXT_PUBLIC_ prefixen.
# Den Schluessel in .env.local eintragen (gitignored, hat Vorrang vor .env).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_S=45

# Laufzeitdaten; fuer ECS auf persistenten Speicher (zum Beispiel EFS) setzen.
APOBANK_DB_PATH=data/apobank.db
APOBANK_VAULT_PATH=Obsidian/hackathon
APOBANK_VAULT_NAME=hackathon
APOBANK_UPLOAD_PATH=data/uploads
